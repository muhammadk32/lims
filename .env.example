# ---------- LabMS Environment ----------
# Copy this file to .env and fill in real values.

# ---- Flask ----
SECRET_KEY=change-me-to-a-random-64-char-string
FLASK_ENV=development
FLASK_DEBUG=1

# ---- Database ----
# Development (SQLite):
DATABASE_URL=sqlite:///database.db

# Production (PostgreSQL) — uncomment and edit:
# DATABASE_URL=postgresql://lms_user:strong_password@localhost:5432/lab_management_db

# ---- Lab branding / display ----
# Currency symbol shown next to amounts. Leave blank for plain numbers.
# Examples: Rs, Rs., PKR, $, EUR
APP_CURRENCY=Rs

# Timezone used for PDF reports and "localtime" display.
TIMEZONE=Asia/Karachi

# ---- Docker / production ----
PORT=8000
GUNICORN_WORKERS=4
